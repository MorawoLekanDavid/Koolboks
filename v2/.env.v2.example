# Supply real values only through the deployment secret manager.
ITURA_DATABASE_URL=
ITURA_DATABASE_SCHEMA=itura
ITURA_ORIGIN=
# Set to 1 for local development only. Production requires PostgreSQL/HTTPS.
ITURA_LOCAL_DEVELOPMENT=0
# The channel/AI settings refer to these names; secret values never return to the UI.
ITURA_SECRET_META_APP=
ITURA_SECRET_WHATSAPP=
ITURA_SECRET_VERIFY=
ITURA_SECRET_GROQ=
# Set while preparing the console's Vercel routing, never in browser code.
ITURA_API_ORIGIN=
